#include <Arduino.h>

// Cylon Sweep using for loops and delay
// This program creates a cylon sweep effect with an LED.
// Short end of the LED is connected to ground.

int ledPins[] = {GPIO_NUM_22, GPIO_NUM_23, GPIO_NUM_17, GPIO_NUM_18, GPIO_NUM_16, GPIO_NUM_21}; // Array of LED pins
int numLeds = 6; // Number of LEDs
int delayTime = 1000; // Wait time in milliseconds


void setup() {
  // Set pin modes for all LED pins
  for (int i = 0; i < numLeds; i++) {
    pinMode(ledPins[i], OUTPUT);
  }
}

void loop() {
  // Sweep forward
  for (int i = 0; i < numLeds; i++) {
    digitalWrite(ledPins[i], HIGH); // Turn on the LED
    delay(delayTime);                     // Wait for a short duration
    digitalWrite(ledPins[i], LOW);  // Turn off the LED
  }

  // Sweep backward
  for (int i = numLeds - 2; i > 0; i--) {
    digitalWrite(ledPins[i], HIGH);
    delay(delayTime);
    digitalWrite(ledPins[i], LOW);
  }
}

